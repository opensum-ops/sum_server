# sum_server configuration. copy to .env and edit. All keys are SUM_SERVER_-prefixed.

# Async PostgreSQL DSN
SUM_SERVER_DATABASE_URL=postgresql+asyncpg://sum:sum@localhost:5432/sum_server

# Ed25519 signing key. Either a filesystem path (PEM or raw 32-byte seed) or
# "inline:<base64-encoded 32-byte seed>" for dev/testing.
SUM_SERVER_SIGNING_PRIVATE_KEY=/var/lib/sum_server/signing.key

# Token TTLs
SUM_SERVER_SESSION_TOKEN_TTL_SECONDS=1209600    # 14 days
SUM_SERVER_ENROLLMENT_TOKEN_TTL_SECONDS=3600    # 1 hour
SUM_SERVER_AGENT_TOKEN_TTL_SECONDS=0            # 0 = no expiry
SUM_SERVER_JOB_DEFAULT_TTL_SECONDS=3600         # 1 hour

# Logging
SUM_SERVER_LOG_LEVEL=info                       # debug|info|warning|error
SUM_SERVER_LOG_FORMAT=console                   # console|json

# Runtime environment. "prod" enforces strict checks (TLS, signing key from path).
SUM_SERVER_ENV=dev

# Bootstrap admin (created at startup if no admin exists). Leave empty to disable.
SUM_SERVER_BOOTSTRAP_ADMIN_EMAIL=
SUM_SERVER_BOOTSTRAP_ADMIN_PASSWORD=